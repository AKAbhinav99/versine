# Dependencies (there are none, this app has no build step)
node_modules/

# OS noise
.DS_Store

# Benchmark image set.
# The labelled photographs the detector is evaluated against are NOT in this repo.
# Several are clinical photographs of patients, used for local evaluation only and
# not redistributed. bench/README.md explains how to assemble your own set.
bench/images/
bench/set/
# Bundled clinic index is data, not media, keep it
!data/clinics/*.json
*.jpg
*.jpeg
*.png
*.webp
.vercel

# The iOS app's icon and launch mark (drawn by ios/tools/make-icons.swift) are
# part of the app, unlike the photographs above.
!ios/Versine/Assets.xcassets/**/*.png

# MediaPipe and the pose model, which the iOS app bundles. ios/bundle-web.sh
# caches them outside the repository and copies them into the build; they are
# never committed.
vendor/
*.task
*.wasm

# Xcode per-user state
xcuserdata/
*.xcuserstate
